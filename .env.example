# Required. Keep this server-side; never expose it in browser code.
GEMINI_API_KEY=your-gemini-api-key

# Legacy local Blob authentication. New Vercel projects use short-lived OIDC
# credentials automatically when a private Blob store is connected.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token

# Optional. Enables the OpenAI Whisper fallback for files up to 4 MB.
OPENAI_API_KEY=your-openai-api-key

# Optional model overrides.
TRANSCRIPTION_MODEL=gemini-3.5-transcribe
LONG_AUDIO_MODEL=gemini-3.8-flash
WHISPER_MODEL=whisper-1
DOCUMENT_MODEL=gemini-3.8-flash

# Optional server settings.
PORT=3000
MAX_AUDIO_UPLOAD_MB=200
