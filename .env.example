# Required. Create a free key at https://console.groq.com/keys.
# Used for audio transcription (Groq Whisper). Keep this server-side;
# never expose it in browser code.
GROQ_API_KEY=your-groq-api-key

# Required. Create a key at https://console.anthropic.com/settings/keys.
# Used for document generation (minutes, reports, translations, executive
# versions, attendee emails). Keep this server-side too.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional. Enables imports from Fireflies meeting/transcript links.
FIREFLIES_API_KEY=your-fireflies-api-key

# Legacy local Blob authentication. New Vercel projects use short-lived OIDC
# credentials automatically when a private Blob store is connected.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token

# Optional Groq transcription model and chunk controls.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_CHUNK_MINUTES=15
GROQ_CHUNK_CONCURRENCY=2

# Optional Claude model controls.
CLAUDE_DOCUMENT_MODEL=claude-sonnet-5-5
CLAUDE_FOLLOWUP_MODEL=claude-sonnet-5-5

# Optional server settings.
PORT=3000
MAX_AUDIO_UPLOAD_MB=200

# Optional. Enables accounts, login, and saved document history.
# Use a Postgres connection string (Neon, Vercel Postgres, Supabase, etc).
# Without this, the app works as before, just without accounts.
DATABASE_URL=postgres://user:password@host/database
