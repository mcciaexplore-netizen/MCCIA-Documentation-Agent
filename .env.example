# Required. Create a free key at https://console.groq.com/keys.
# Used for BOTH audio transcription (Groq Whisper) and document generation
# (Groq Llama 3.3 70B / Qwen 2.5) with ZERO API COST ($0.00). Keep this server-side.
GROQ_API_KEY=your-groq-api-key

# Optional: Document provider ('groq' by default for 100% free operation, or 'anthropic' for Claude).
DOCUMENT_PROVIDER=groq
GROQ_DOCUMENT_MODEL=llama-3.3-70b-versatile
GROQ_FOLLOWUP_MODEL=llama-3.3-70b-versatile

# Optional. Only required if DOCUMENT_PROVIDER=anthropic.
# Create a key at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Required only if ANTHROPIC_API_KEY is an organization-level key not scoped
# to one workspace. If Claude requests fail with "This API key is not scoped
# to a workspace...", find the workspace ID at
# https://console.anthropic.com/settings/workspaces and set it here.
ANTHROPIC_WORKSPACE_ID=

# Optional. Enables imports from Fireflies meeting/transcript links.
FIREFLIES_API_KEY=your-fireflies-api-key

# Required for large audio uploads. Create a project at https://supabase.com,
# then create a private Storage bucket (see README "Supabase Storage setup").
# SUPABASE_URL and SUPABASE_ANON_KEY are safe to expose to the browser; they
# are only used to perform a pre-authorized, time-limited upload. Never
# expose SUPABASE_SERVICE_ROLE_KEY — it has full admin access.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=recordings

# Optional Groq transcription model and chunk controls.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_CHUNK_MINUTES=15
GROQ_CHUNK_CONCURRENCY=2

# Optional Claude model controls.
CLAUDE_DOCUMENT_MODEL=claude-sonnet-5-5
CLAUDE_FOLLOWUP_MODEL=claude-sonnet-5-5

# Optional server settings.
PORT=3000
MAX_AUDIO_UPLOAD_MB=200
